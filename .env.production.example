# Production environment configuration -- Employee Compliance SaaS
#
# Complete list of every environment variable apps/api, apps/worker, and the
# migration tool (infra/postgres/migrate.js) read. CHANGE_ME marks a real
# secret that must never be committed with a real value anywhere, in this
# file or otherwise (CLAUDE.md: "NEVER hardcode secrets in source files").
#
# How these values actually get into the running process in production is
# deliberately NOT this file's concern -- see packages/shared's SecretLoader
# interface (EnvSecretLoader reads process.env exactly as today;
# AwsSecretsManagerLoader is a documented E6 stub, not wired up here). This
# file documents *which* variables exist and what each means, independent of
# where they're sourced from.

# ---------------------------------------------------------------------------
# Process / runtime
# ---------------------------------------------------------------------------

# Must be "production" for apps/api -- gates the one migration_user
# exception (PerfController's raw-query endpoint, ADR-010) to 403 outside
# NODE_ENV=test. Never leave this as "development"/"test" in production.
NODE_ENV=production

# apps/api's HTTP listen port. apps/worker does not listen on a port (no
# HEALTHCHECK exists for it yet -- ADR-029 decision #7 -- it is monitored via
# its own structured log lines and BullMQ's own job-state, not HTTP).
PORT=3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
#
# PgBouncer / connection-pooler guidance (ADR-032): if DATABASE_URL below
# ever points at a PgBouncer instance (or a managed equivalent, e.g. RDS
# Proxy) instead of Postgres directly, use `pool_mode = transaction`.
# Empirically verified (ADR-032) against this repo's own SET LOCAL-based
# tenant-context pattern (ADR-003): zero cross-transaction leakage across
# sequential reuse and real concurrent multiplexing of pooled backend
# connections. No code change needed -- this repo's pattern never relies on
# session continuity across transactions, which is the only boundary
# transaction-mode pooling doesn't preserve. Do NOT use `pool_mode =
# session` purely out of caution -- it defeats the point of pooling and is
# not what was validated here. No PgBouncer service exists in this repo's
# compose files yet (E5 scope: guidance only, not a new topology decision).
# ---------------------------------------------------------------------------

# app_user only. Used by apps/api (DrizzleService) and apps/worker
# (createDb()) for every application query. NEVER put migration_user or the
# superuser here -- CLAUDE.md: "NEVER use migration_user in application
# runtime code."
DATABASE_URL=postgresql://app_user:CHANGE_ME@CHANGE_ME:5432/e0db

# migration_user credentials. Not read directly by apps/api or apps/worker
# application code at runtime -- the one sanctioned exception is
# PerfController's raw-query endpoint (ADR-010), hard-gated to
# NODE_ENV=test, unreachable in production regardless of this value. Kept
# here because drizzle-kit (dev-only schema introspection, ADR-012) and this
# repo's tests read it; production deploys do not need it set for the
# running services to function, only for local/CI tooling.
DATABASE_MIGRATION_URL=postgresql://migration_user:CHANGE_ME@CHANGE_ME:5432/e0db

# Postgres SUPERUSER connection. Used ONLY by infra/postgres/migrate.js to
# apply packages/database/migrations/*.sql (see docs/runbooks/deploy.md) --
# never by apps/api or apps/worker. The migration SQL files themselves `SET
# ROLE migration_user` for the statements that create/own objects (see
# 001_roles.sql); migrate.js's own connection has to be the superuser
# because migration_user does not have CREATEROLE and 001_roles.sql is what
# creates migration_user/app_user in the first place (ADR-002). Restrict
# network/firewall access to this credential as tightly as possible --
# rotate it after every migration run if your provider supports on-demand
# superuser credentials.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@CHANGE_ME:5432/e0db

# ---------------------------------------------------------------------------
# Redis (BullMQ queues, apps/worker + apps/api's ImportQueueService)
# ---------------------------------------------------------------------------

REDIS_URL=redis://:CHANGE_ME@CHANGE_ME:6379/1

# ---------------------------------------------------------------------------
# SMTP (apps/worker's SmtpEmailDispatcher, ADR-030) -- generic SMTP, works
# against any provider's SMTP interface (SES, SendGrid, Postmark, corporate
# SMTP) with no code change. In dev/CI these point at the MailHog container
# instead; MailHog is explicitly excluded from
# infra/docker/docker-compose.production.yml.
# ---------------------------------------------------------------------------

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
# "true" for implicit TLS (typically port 465), "false" for STARTTLS/plain
# (typically port 587/25). Verify against your provider's documented port.
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# Used as the nodemailer `from` address when a tenant's own notification
# policy has not set emailFrom (ADR-030 decision #5).
SMTP_FROM_DEFAULT=CHANGE_ME

# ---------------------------------------------------------------------------
# Keycloak (apps/api's AuthGuard/JwtStrategy)
# ---------------------------------------------------------------------------

# Must exactly match the `iss` claim on tokens issued by your production
# Keycloak realm -- a mismatch rejects every otherwise-valid token
# (ADR-008's issuer-confusion protection is deliberate, not a bug to route
# around). Pin your realm's own KC_HOSTNAME the same way
# infra/docker/docker-compose.yml pins it for dev/CI.
KEYCLOAK_ISSUER=https://CHANGE_ME/realms/CHANGE_ME
KEYCLOAK_JWKS_URI=https://CHANGE_ME/realms/CHANGE_ME/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=CHANGE_ME

# KEYCLOAK_ADMIN_URL / KEYCLOAK_ADMIN_USER / KEYCLOAK_ADMIN_PASS
# (see .env.example) are read ONLY by tests/support/keycloak-admin.ts --
# test tooling, not production runtime code. Deliberately omitted here:
# never provision a Keycloak realm-admin credential into a production
# apps/api/apps/worker environment, since neither process ever reads it.
