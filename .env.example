NODE_ENV=development
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/e0db
DATABASE_MIGRATION_URL=postgresql://migration_user:CHANGE_ME@localhost:5432/e0db
# Superuser connection used ONLY by infra/postgres/migrate.js to bootstrap
# roles/schema (e.g. in CI, where there is no docker-entrypoint-initdb.d).
# NEVER used by application runtime code.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/e0db
REDIS_URL=redis://:CHANGE_ME@localhost:6379/1
# E4 Pillar 3: generic SMTP, targets the local MailHog container by default
# (infra/docker/docker-compose.yml) -- no credentials needed for MailHog.
# Point these at a real provider's SMTP interface for production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_DEFAULT=no-reply@example.test
KEYCLOAK_ISSUER=http://localhost:8080/realms/e0-test
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/e0-test/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=e0-api
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=CHANGE_ME
PORT=3000
